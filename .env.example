# Legal Document Analyzer - Environment Configuration Example
# Copy this file to .env and configure your local settings.
# NEVER commit .env to version control or hardcode secrets.

# Language Model API Configuration (for Module 4: RAG Question Answering)
# Provider options:
# 1. OpenAI (Standard):
#    LLM_PROVIDER=openai
#    LLM_API_KEY=your_openai_api_key_here
#    LLM_MODEL_NAME=gpt-3.5-turbo
#
# 2. Groq (Free fast inference option at console.groq.com):
#    LLM_PROVIDER=groq
#    LLM_API_KEY=your_groq_api_key_here
#    LLM_MODEL_NAME=qwen/qwen3.8-27b
#    LLM_BASE_URL=https://api.groq.com/openai/v1
#
# 3. Local Ollama (Free offline option):
#    LLM_PROVIDER=custom
#    LLM_API_KEY=ollama
#    LLM_MODEL_NAME=llama3
#    LLM_BASE_URL=http://localhost:11434/v1

LLM_PROVIDER=openai
LLM_API_KEY=your_llm_api_key_here
LLM_MODEL_NAME=gpt-3.5-turbo
# LLM_BASE_URL=https://api.openai.com/v1

# Embedding Model Configuration (Module 3)
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
